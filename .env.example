# Copy this file to .env.local at the repo ROOT (not inside frontend/).
# Both the server (Vercel functions) and the client (Vite build) read
# from this one file — vite.config.ts is configured with envDir: ".."
# so VITE_* vars in this file reach the browser bundle.

# --- Mode flags ---
USE_MOCK_AI=true
# When true, lib/dataforseo.ts returns deterministic fake data instead of
# calling the paid DataForSEO API. Use this in local development to avoid
# burning credits while building features.
USE_MOCK_DATAFORSEO=true
NODE_ENV=development

# --- Supabase (EU region) ---
# Server-side (used by api/* and scripts/*):
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side (exposed to the browser — set to the same URL/anon as above):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Google Search Console OAuth ---
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:3000/api/gsc/callback

# 32-byte hex key for AES-256-GCM encryption of stored OAuth tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# 32-byte hex secret used to HMAC-sign the OAuth `state` parameter.
# Different value than TOKEN_ENCRYPTION_KEY. Rotate freely — only affects
# in-flight authorization redirects (10 min TTL).
OAUTH_STATE_SECRET=

# --- Stripe (Phase 3 billing) ---
# Dashboard: https://dashboard.stripe.com/apikeys
# Use sk_test_* in development. Webhook secret comes from
# Dashboard → Developers → Webhooks → the endpoint you create.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Absolute base URL used to build Stripe success/cancel URLs from cron jobs
# (where there is no request `Origin` header to fall back on).
APP_URL=http://localhost:5173

# --- DataForSEO (Phase 2) ---
# Sign up at https://app.dataforseo.com/register — your API credentials are
# shown in the dashboard under "API Access". The login is usually your email;
# the password is generated for you.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Mail (optional) ---
# Format: "<https endpoint>::<api key>". Example for Resend:
#   SMTP_URL=https://api.resend.com/emails::re_xxx
SMTP_URL=
EMAIL_FROM=climbr.io <no-reply@climbr.io>

# --- Limits ---
AUDIT_TTL_DAYS=180
ANON_AUDITS_PER_IP_PER_HOUR=5
FREE_AUDITS_PER_MONTH=3
FREE_TRACKED_KEYWORDS=5
