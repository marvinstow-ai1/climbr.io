# Copy this file to .env.local at the repo ROOT (not inside frontend/).
# Both the server (Vercel functions) and the client (Vite build) read
# from this one file — vite.config.ts is configured with envDir: ".."
# so VITE_* vars in this file reach the browser bundle.

# --- Mode flags ---
USE_MOCK_AI=true
MOCK_GSC=true
MOCK_DATAFORSEO=true
NODE_ENV=development

# --- Supabase (EU region) ---
# Server-side (used by api/* and scripts/*):
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side (exposed to the browser — set to the same URL/anon as above):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Google Search Console OAuth ---
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:3000/api/gsc/callback

# 32-byte hex key for AES-256-GCM encryption of stored OAuth tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# 32-byte hex secret used to HMAC-sign the OAuth `state` parameter.
# Different value than TOKEN_ENCRYPTION_KEY. Rotate freely — only affects
# in-flight authorization redirects (10 min TTL).
OAUTH_STATE_SECRET=

# --- DataForSEO (SERVERSEITIG — niemals im Client) ---
# Holst du in deinem DataForSEO-Dashboard unter "API Access":
#   - DATAFORSEO_LOGIN    = der dort angezeigte "API Login"
#   - DATAFORSEO_PASSWORD = der dort angezeigte "API Password" (lange ID, nicht
#                           dein normales Login-Passwort)
# Sind beide leer oder MOCK_DATAFORSEO=true, läuft alles über den Mock.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Mail (optional) ---
SMTP_URL=

# --- Limits ---
AUDIT_TTL_DAYS=180
ANON_AUDITS_PER_IP_PER_HOUR=5
FREE_AUDITS_PER_MONTH=3
FREE_TRACKED_KEYWORDS=5
